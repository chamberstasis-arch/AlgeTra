# Copia este archivo a `.env` y completa los valores. `.env` está en .gitignore: no lo subas.

# Credenciales de Mathpix (https://console.mathpix.com → API keys).
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Modo simulado: no llama a Mathpix y devuelve ejemplos de álgebra lineal.
# Útil para probar la interfaz y el DOCX sin gastar cuota. Las métricas no son reales.
MATHPIX_MOCK=0

# Opcionales (valores por defecto)
# PORT=3001
# DATA_DIR=./data
# MATHPIX_CONCURRENCY=3          # imágenes en paralelo hacia Mathpix (1–10)
# MATHPIX_MAX_ATTEMPTS=3         # reintentos ante 429/5xx/timeout, con backoff
# MATHPIX_TIMEOUT_MS=60000
# MATHPIX_COST_PER_IMAGE_USD=0.002
# MATHPIX_BUDGET_USD=5           # tope de gasto estimado; al alcanzarlo, las páginas nuevas fallan con budget_exceeded. 0 = sin tope
