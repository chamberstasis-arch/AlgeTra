{
  "name": "algetra-prototipo-mvp-0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "dev:all": "concurrently -k -n api,web -c blue,green \"pnpm dev:server\" \"pnpm dev\"",
    "dev:mock": "MATHPIX_MOCK=1 concurrently -k -n api,web -c blue,green \"pnpm dev:server\" \"pnpm dev\"",
    "test": "vitest run",
    "mathpix:check": "tsx scripts/check-mathpix.ts",
    "probar": "tsx scripts/probar.ts",
    "harness": "tsx scripts/harness.ts",
    "ui": "tsx server/ui.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "temml": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^5.1.1"
  }
}
